{
  "name": "@gmod/hclust",
  "version": "4.0.4",
  "packageManager": "pnpm@11.15.1",
  "description": "Hierarchical clustering",
  "keywords": [
    "jbrowse",
    "clustering",
    "wasm",
    "hierarchical-clustering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GMOD/hclust.git"
  },
  "author": "JBrowse Team",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "esm",
    "src"
  ],
  "scripts": {
    "test": "vitest",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.lint.json",
    "clean": "rimraf dist esm",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:wasm": "bash scripts/build_wasm.sh",
    "test:pack": "./scripts/test-pack.sh",
    "build:esm": "tsc --outDir esm",
    "build:es5": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "build": "pnpm build:wasm && pnpm build:esm && pnpm build:es5",
    "prebuild": "pnpm clean",
    "postbuild:es5": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "preversion": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test --run && pnpm test:pack",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "eslint": "^9.39.5",
    "eslint-plugin-import-x": "^4.17.1",
    "git-cliff": "^2.13.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "main": "dist/index.js"
}
