{
  "name": "@gmod/hclust",
  "version": "4.0.3",
  "packageManager": "pnpm@11.15.1",
  "description": "Hierarchical clustering",
  "keywords": [
    "jbrowse",
    "clustering",
    "wasm",
    "hierarchical-clustering"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/hclust.git"
  },
  "author": "JBrowse Team",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./esm/index.d.ts",
      "default": "./esm/index.js"
    },
    "require": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "esm"
  ],
  "scripts": {
    "test": "vitest",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "clean": "rimraf dist esm tsconfig.build.tsbuildinfo",
    "format": "prettier --write .",
    "build:wasm": "bash scripts/build_wasm.sh && cp src/wasm/distance.js src/wasm/distance.d.ts src/",
    "build:esm": "tsc --outDir esm",
    "build:cjs": "tsc --module commonjs --moduleResolution bundler --outDir dist",
    "build": "pnpm build:wasm && pnpm build:esm && pnpm build:cjs",
    "prebuild": "pnpm clean",
    "postbuild": "echo '{\"type\": \"commonjs\"}' > dist/package.json",
    "preversion": "pnpm lint && pnpm build && pnpm test --run",
    "version": "git-cliff --tag v$npm_package_version --unreleased --prepend CHANGELOG.md && prettier --write CHANGELOG.md && git add CHANGELOG.md",
    "postversion": "git push --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import-x": "^4.16.2",
    "git-cliff": "^2.13.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5"
  }
}
